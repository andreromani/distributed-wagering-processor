{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "bun ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "start": "bun ./dist/main.js",
    "start:prod": "bun ./dist/main.js",
    "start:dev": "bun run build && bun --watch ./dist/main.js",
    "build:watch": "bun ./node_modules/typescript/bin/tsc -p tsconfig.build.json --watch",
    "start:debug": "bun --inspect ./dist/main.js",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "bun ./node_modules/oxlint/bin/oxlint --type-aware src/ test/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test ./test/",
    "migration:generate": "bun run build && bun ./node_modules/typeorm/cli.js migration:generate -d ./dist/infrastructure/database/data-source.js --esm",
    "migration:run": "bun run build && bun ./node_modules/typeorm/cli.js migration:run -d ./dist/infrastructure/database/data-source.js",
    "migration:revert": "bun run build && bun ./node_modules/typeorm/cli.js migration:revert -d ./dist/infrastructure/database/data-source.js",
    "migration:show": "bun run build && bun ./node_modules/typeorm/cli.js migration:show -d ./dist/infrastructure/database/data-source.js",
    "test:unit": "bun test ./test/unit/",
    "test:integration": "bun run build && bun test ./test/integration/"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2",
    "@types/bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.x"
  }
}
